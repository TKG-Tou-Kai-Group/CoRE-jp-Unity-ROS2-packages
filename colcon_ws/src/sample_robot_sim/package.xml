<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sample_robot_sim</name>
  <version>0.0.0</version>
  <description>Unity_ROS2_Robot_Simulator 上で CoRE のステージとサンプルロボットを動かす launch 一式</description>

  <maintainer email="hijimasa@gmail.com">Masaaki Hijikata</maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>hardware_interface</exec_depend>

  <!-- Unity のシミュレータとやり取りする側 -->
  <exec_depend>core_sim_utils</exec_depend>
  <exec_depend>core_stage_description</exec_depend>
  <exec_depend>flying_disc_description</exec_depend>
  <exec_depend>sample_robot_description</exec_depend>
  <exec_depend>simulation_ros2_utils</exec_depend>
  <exec_depend>topic_based_ros2_control</exec_depend>
  <exec_depend>ros_tcp_endpoint</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <!-- 試合まわり -->
  <exec_depend>game_manager</exec_depend>
  <exec_depend>hp_manager</exec_depend>
  <exec_depend>core_jp_camera_publisher</exec_depend>
  <exec_depend>omni_wheel_controller</exec_depend>
  <exec_depend>teleop_twist_joy_for_sample_robot</exec_depend>
  <exec_depend>velocity_pub</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>xacro</exec_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
