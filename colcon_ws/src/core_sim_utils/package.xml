<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>core_sim_utils</name>
  <version>0.0.0</version>
  <description>Unity_ROS2_Robot_Simulator へワールドとフライングディスクを送り込むためのクライアントノード群</description>
  <maintainer email="hijimasa@gmail.com">Masaaki Hijikata</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>simulation_interfaces</exec_depend>
  <!-- operator_stream: 操縦画面の H.264 配信 -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>ffmpeg</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
