<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="sample_robot_ros2_control" params="name use_fake_hardware:=^|false fake_sensor_commands:=^|false use_sim:=^|false">

    <!--
      ros2_control が担うのは射出機構だけ。走行はシミュレータ側の
      body_twist_drive (simulation/sample_robot.simulation.xacro) が
      /<機体名>/cmd_vel を直接受け取って行うので、車輪の関節は無くなった。
    -->
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_fake_hardware}">
          <plugin>fake_components/GenericSystem</plugin>
          <param name="fake_sensor_commands">${fake_sensor_commands}</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:if value="${use_sim}">
          <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
          <!--
            シミュレータの joint_states は /joint_states とは別名にする。
            joint_state_broadcaster も同じ名前で publish するため、名前を揃えると
            1 つのトピックに publisher が 2 つ並ぶ。値の出どころは同じなので走行は
            するが、購読側はどちらのメッセージを受け取ったか区別できない。実際、
            シミュレータは全 39 関節、broadcaster は ros2_control の 7 関節だけを
            流すので、ローラの状態を見ようとして 7 関節のメッセージを掴む、という
            取り違えが起きる。

            この param はシミュレータの publish 先と topic_based_ros2_control の
            購読先の両方に効くので、片方だけずれることはない。
          -->
          <param name="joint_commands_topic">/${name}/joint_command</param>
          <param name="joint_states_topic">/${name}/sim_joint_states</param>
          <param name="sum_wrapped_joint_states">true</param>
          <!--
            Unity_ROS2_Robot_Simulator は ground_truth の publish 先も
            ros2_control の param から読む。既定名は全ロボット共通なので、
            8 台同時に出すとぶつかる。ロボット名で分けておく。
            (topic_based_ros2_control 側は知らない param なので無視される)
          -->
          <param name="ground_truth_topic">/${name}/ground_truth</param>
        </xacro:if>
      </hardware>
      <joint name="shooter_wheel1_link_joint">
        <command_interface name="velocity">
          <param name="min">0</param>
          <param name="max">1600</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="shooter_wheel2_link_joint">
        <command_interface name="velocity">
          <param name="min">0</param>
          <param name="max">1600</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="shooter_loader_link_joint">
        <command_interface name="velocity">
          <param name="min">0</param>
          <param name="max">6</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
