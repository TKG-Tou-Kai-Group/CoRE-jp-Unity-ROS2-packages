<?xml version="1.0"?>
<robot name="sample_robot_8" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_sim" default="false" />
  <!-- raw か jpeg。台数を積む構成では jpeg で経路の詰まりを避ける -->
  <xacro:arg name="camera_format" default="raw" />
  
  <xacro:arg name="robot_name" default="sample_robot_8"/>

  <xacro:include filename="$(find sample_robot_description)/urdf/common.xacro"/>
  <xacro:include filename="$(find sample_robot_description)/urdf/base/base.urdf.xacro"/>
  <xacro:include filename="$(find sample_robot_description)/urdf/shooter/shooter.urdf.xacro"/>

  <xacro:include filename="$(find sample_robot_description)/simulation/sample_robot.simulation.xacro"/>
  <xacro:include filename="$(find sample_robot_description)/ros2_control/sample_robot.ros2_control.xacro"/>

  <xacro:sample_robot_collision_materials/>

  <!-- =============== Link & Joint =============== -->
  <!-- Base -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
                         iyy="0.00001" iyz="0"
                                 izz="0.00001" />
    </inertial>
  </link>
  <xacro:base_v0 parent="base_link" skids="true">
	<origin xyz="0 0 0.06"/>
  </xacro:base_v0>

  <!--
    駆動系はここにあったオムニホイール 4 輪 (1 輪あたりフリーローラ 8 個 +
    ハウジング 2 個、4 輪で 40 リンク) を外してある。走行はシミュレータ側の
    body_twist_drive が車体へ直接力を加えて行う
    (simulation/sample_robot.simulation.xacro を参照)。
    接地と車輪の見た目は base_v0 の skids="true" が受け持つ。
  -->

  <!-- 取り付け高さと仰角は shooter.urdf.xacro で射出口の目標高さから逆算する -->
  <xacro:shooter_v0 parent="base_link">
	<origin xyz="0 0 ${shooter_mount_z}" rpy="0 ${-shooter_elevation} 0"/>
  </xacro:shooter_v0>

  <!-- Base -->
  <xacro:base_gazebo_v0/>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.45 0 0.28" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
                         iyy="0.00001" iyz="0"
                                 izz="0.00001" />
    </inertial>
  </link>

  <joint name="top_view_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="top_view_camera_link"/>
    <origin xyz="0.0 0 10.0" rpy="0 ${pi/2} 0"/>
  </joint>
  <link name="top_view_camera_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
                         iyy="0.00001" iyz="0"
                                 izz="0.00001" />
    </inertial>
  </link>

  <joint name="armor1_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="armor1_link"/>
    <origin xyz="0.35 0.35 0.45" rpy="0 0 ${pi/4}"/>
  </joint>
  <link name="armor1_link">
    <visual>
      <geometry>
        <box size="0.01 0.15 0.15" />
      </geometry>
      <material name="yellow_green"/>
    </visual>
    <collision>
      <collision_material name="robot_body"/>
      <geometry>
        <box size="0.01 0.15 0.15" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
                         iyy="0.1" iyz="0"
                                 izz="0.1" />
    </inertial>
  </link>

  <joint name="armor2_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="armor2_link"/>
    <origin xyz="-0.35 0.35 0.45" rpy="0 0 ${pi*3/4}"/>
  </joint>
  <link name="armor2_link">
    <visual>
      <geometry>
        <box size="0.01 0.15 0.15" />
      </geometry>
      <material name="yellow_green"/>
    </visual>
    <collision>
      <collision_material name="robot_body"/>
      <geometry>
        <box size="0.01 0.15 0.15" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
                         iyy="0.1" iyz="0"
                                 izz="0.1" />
    </inertial>
  </link>

  <joint name="armor3_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="armor3_link"/>
    <origin xyz="-0.35 -0.35 0.45" rpy="0 0 ${-pi*3/4}"/>
  </joint>
  <link name="armor3_link">
    <visual>
      <geometry>
        <box size="0.01 0.15 0.15" />
      </geometry>
      <material name="yellow_green"/>
    </visual>
    <collision>
      <collision_material name="robot_body"/>
      <geometry>
        <box size="0.01 0.15 0.15" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
                         iyy="0.1" iyz="0"
                                 izz="0.1" />
    </inertial>
  </link>

  <joint name="armor4_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="armor4_link"/>
    <origin xyz="0.35 -0.35 0.45" rpy="0 0 ${-pi/4}"/>
  </joint>
  <link name="armor4_link">
    <visual>
      <geometry>
        <box size="0.01 0.15 0.15" />
      </geometry>
      <material name="yellow_green"/>
    </visual>
    <collision>
      <collision_material name="robot_body"/>
      <geometry>
        <box size="0.01 0.15 0.15" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
                         iyy="0.1" iyz="0"
                                 izz="0.1" />
    </inertial>
  </link>

  <xacro:sample_robot_simulation prefix="" camera_format="$(arg camera_format)"/>
  <xacro:sample_robot_ros2_control name="$(arg robot_name)" use_sim="$(arg use_sim)"/>

</robot>
