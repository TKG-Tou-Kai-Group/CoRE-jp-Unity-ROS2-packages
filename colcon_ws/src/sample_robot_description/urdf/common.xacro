<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="pi" params="3.1415926535897931" />

  <!--
    接触摩擦の定義。Isaac 版は <material> に <isaac_rigid_body> をぶら下げて
    いましたが、Unity_ROS2_Robot_Simulator は <robot> 直下の
    <collision_material> を名前で参照する方式です (docs/URDF-Collision-Material.md)。
    <isaac_rigid_body> はそのまま残してあります (Unity 側は読まずに無視する)。

    combine は既定が average で、床のマテリアル (Unity 既定 0.6) と平均されて
    しまうため、指定値をそのまま効かせたい床面接触には maximum を使います。
    逆に低摩擦を効かせたいシュータ内部は minimum です。
  -->
  <!-- 射出輪の contact_offset。Unity の既定は 0.01。shooter.urdf.xacro が
       射出輪の間隔を決めるときにも参照する (増分だけ間隔を広げて相殺する)。 -->
  <xacro:property name="roller_contact_offset" value="0.01"/>

  <xacro:macro name="sample_robot_collision_materials">
    <!-- 車輪のバレル: 床をつかむ側。指定値を確実に効かせる -->
    <collision_material name="wheel_barrel">
      <friction static="1.0" dynamic="1.0" combine="maximum"/>
    </collision_material>
    <!--
      接地脚。オムニホイールを BodyTwistDrive (車体への直接加力) へ置き換えた
      構成で、車体を床から浮かせるためだけに使う球。推進は加力で行うので、
      床とは擦らせない。combine="minimum" は床の材質 (Unity 既定 0.6) に
      関わらず 0 を効かせるため。
    -->
    <collision_material name="skid">
      <friction static="0.0" dynamic="0.0" combine="minimum"/>
    </collision_material>
    <!-- 車体・バンパ・装甲 -->
    <collision_material name="robot_body">
      <friction static="1.0" dynamic="1.0" combine="maximum"/>
    </collision_material>
    <!-- シュータ内部: ディスクが引っ掛からないよう低摩擦にする -->
    <collision_material name="shooter_unit">
      <friction static="0.2" dynamic="0.0" combine="minimum"/>
    </collision_material>
    <!--
      射出輪だけは掴む側。ディスクの材質は dynamic 0.1 の minimum なので、
      こちらを minimum のままにすると接線力がまったく出ず、フライホイール式の
      射出が成立しない (ディスクは輪をすり抜けて足元に落ちる)。maximum は
      minimum より優先されるので、ディスク側の指定に関わらずこの値が効く。
      通路の壁は shooter_unit のままなので、引っ掛かりは増えない。
    -->
    <collision_material name="shooter_roller">
      <friction static="1.0" dynamic="0.9" combine="maximum"/>
      <contact_offset value="${roller_contact_offset}"/>
      <!--
        contact_offset は「接触を生成し始める距離」だが、実測では見かけの半径として
        振る舞う。0.02 にして射出輪の間隔を +0.01 広げ、幾何的には 8 mm の隙間が
        空く配置にしても、20 発すべてが 31〜36 m/s で発射された。触れていないのに
        駆動されている以上、殻の厚みぶん太った円柱として効いている。値を変えるなら
        shooter.urdf.xacro の roller_offset で間隔を補正すること (相殺済み)。

        過速で飛ぶ弾 (38〜100 m/s) を減らせないかと値を振ってみたが、決着していない。
        20 発ずつの測定で:

          0.01 (既定)      方位の中央値 +0.57 度、正常な弾 -0.21〜+0.64 度、過速 4/20
          0.02 + 間隔補正  1 回目 -0.11 度 / -0.89〜+0.21 度、2 回目 +0.72 度 /
                           -0.27〜+2.94 度。回ごとの差が設定間の差より大きい
          0.03 + 間隔補正  悪化 (弱い弾が増え、過速も 6/15 に増える)

        0.02 が良く見えた回もあるが再現しない。判定するなら各設定で複数回まわすこと。
        既定のままにしてある。
      -->
    </collision_material>
  </xacro:macro>
  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1.0"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>
  <material name="shooter_unit">
    <color rgba="0.4 0.4 0.4 1.0"/>
    <isaac_rigid_body static_friction="0.2" dynamic_friction="0.0"/>
  </material>
  <material name="red">
    <color rgba="1.0 0 0 1.0"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>
  <material name="light_red">
    <color rgba="1.0 0.5 0.5 0.6"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>
  <material name="yellow">
    <color rgba="1.0 1.0 0.0 1.0"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>
  <material name="yellow_green">
    <color rgba="0.5 1.0 0.0 1.0"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>
  <material name="light_blue">
    <color rgba="0.5 0.5 1.0 0.6"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>
  <material name="purple">
    <color rgba="1.0 0.0 1.0 1.0"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>
  <material name="blue_green">
    <color rgba="0.0 1.0 0.5 1.0"/>
    <isaac_rigid_body static_friction="1.0" dynamic_friction="1.0"/>
  </material>

</robot>
