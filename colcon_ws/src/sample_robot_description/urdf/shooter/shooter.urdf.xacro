<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    射出輪の諸元。ここだけ触れば噛み具合を調整できる。

    disc_radius        ディスクの半径 (flying_disc_description と揃えること)
    roller_radius      射出輪の半径
    roller_width       射出輪の厚み。ディスクの厚み 0.02 より広く取り、
                       ディスクが上下にずれても外れないようにする
    roller_squeeze     片側あたりの食い込み量。射出輪の間隔はこれで決まる:
                         y = ±(disc_radius + roller_radius - roller_squeeze)

    以前は射出輪の中心が y = ±0.12、半径 0.04 で内面が ±0.08、ディスク直径 0.18
    に対して片側 10 mm も食い込んでいた。剛体どうしでこれだけ貫入すると解消時に
    過大な力積が出て、同じ指令でも足元に落ちる弾と 350 m 飛ぶ弾が混ざる。接線力で
    送り出すには法線力が要るので 0 にはせず、わずかに噛ませる。

    wall_clearance  通路の壁とディスクの片側あたりの隙間。

    食い込みは隙間より大きく取ること。小さいと、遊びの範囲でディスクが片側へ
    寄ったとき反対側の輪に届かず、片輪だけで蹴られる。実測では射出の半数が
    そうなっていて、正常な 33〜35 m/s に対して 10〜18 m/s しか出ず、方位も
    -12〜+14 度に散っていた (両輪で噛んだ弾は +0.3〜+1.2 度に収まる)。
    以前は隙間 10 mm に対して食い込み 1 mm だった。

    ここから先を詰めても方位のばらつきは縮まない (調査済み)。
    いまの値では初速が理論どおり (中央 20.2 m/s、physics_hz 800) 出ていて
    片輪噛みは解消しているが、方位は 1 回あたり 11 度前後散る。原因は
    「剛体 2 つに挟まれて加速する」方式そのもので、抜ける瞬間の接触状態が
    発射ごとに変わることによる。次の 6 条件を 16 発 x 6 回ずつ測ったが、
    どれも測定のばらつき (方位の四分位 4.5〜6.8 度、幅 10.5〜18.3 度) の帯から
    出なかった。

      wall_clearance   1.5 / 0.75 / 0.3 mm
      wall_length      壁を輪の引き継ぎ位置 (x = 0.1336) まで延長
      roller_squeeze   2 -> 1 mm
      physics_hz       200 / 400 / 800
      solver_iterations 既定 / 16

    3 回程度の試行だと偶然の差が出る (実際 0.75 mm と 400 Hz/反復 16 で
    「改善した」ように見えたが、6 回に増やすと消えた)。ここを触るなら
    6 回以上測ること。消したいなら寸法ではなく射出方式を変えるしかない。
  -->
  <xacro:property name="disc_radius"   value="0.09"/>
  <xacro:property name="roller_radius" value="0.04"/>
  <xacro:property name="roller_width"  value="0.03"/>
  <xacro:property name="roller_squeeze" value="0.002"/>
  <xacro:property name="wall_thickness" value="0.02"/>
  <xacro:property name="wall_clearance" value="0.0015"/>
  <xacro:property name="wall_y"
                  value="${disc_radius + wall_clearance + wall_thickness / 2}"/>
  <!-- 通路は射出輪の前縁 (x = 0.15 - 0.04 = 0.11) まで案内する。以前は x = 0.10 で
       終わっていて、噛む直前の 1 cm が無案内だった。 -->
  <xacro:property name="wall_length" value="0.22"/>
  <xacro:property name="wall_center_x" value="0.01"/>
  <!--
    壁の高さは積み込み全体を覆う。以前は 0.08 (シュータ座標で z = 0.01〜0.09) しか
    なく、囲えていたのは最下段の 1 枚だけだった。ディスクは base_link 基準で
    z = 0.55 から 0.025 間隔に 20 枚積むので、上の 19 枚は横に支えが無い自立した
    積み重ねになり、崩れて傾く。

    傾いた弾は射出輪に噛まない。実測 160 発で、傾き 6 度以下は 118/121 (98%) が
    射出されたのに対し、13 度以上は 4/39 (10%) しか出ていない。射出失敗の 24% は
    ここが原因だった。

    積み込みの上端はシュータ座標で z = 0.575 なので、余裕を見て 0.595 まで覆う。
    枚数や間隔を変えるときはここも合わせること。
  -->
  <xacro:property name="wall_height" value="0.585"/>
  <xacro:property name="wall_center_z" value="${0.01 + wall_height / 2}"/>
  <!--
    間隔には roller_contact_offset (common.xacro で定義) の増分も足す。
    contact_offset は接触を生成し始める距離なので、大きくすると触れる前から
    投機的接触で速度が制限され、見かけ上ローラーが太ったように振る舞う。間隔を
    そのままで広げると実効的な食い込みが増えるため、既定 0.01 からの増分だけ
    間隔を広げて相殺する。
  -->
  <xacro:property name="roller_offset"
                  value="${disc_radius + roller_radius - roller_squeeze
                          + (roller_contact_offset - 0.01)}"/>
  <!-- 実体に見合った慣性。以前は質量 10 kg・慣性 1.0 で、半径 0.04 の円盤として
       ありえない値だった (izz = m r^2 / 2 なら 0.008)。慣性が過大なぶん食い込みの
       反力を一切受け流さず、上の力積を増幅していた。800 rad/s での回転エネルギは
       この値でも 1 発 (7.7 J) に対して十分余裕がある。 -->
  <!--
    バレル (押さえ) の寸法。
    ディスクは底板の上面 (シュータ座標 z = +0.04) に載り、厚み 0.02 なので
    上面が +0.06。バレルの下面をそこから barrel_clearance だけ上に置くと、
    通路で待っているディスクが浮き上がれなくなる。

    以前はバレルが x +0.10〜+0.20 にしか無く、ディスクが待機する通路
    (x -0.10〜+0.12) の上には何も無かった。押さえが無いぶん噛み方が安定せず、
    初速がばらついていた (中央 25.8 m/s、理論 32 m/s)。通路の後端から
    射出輪の先まで覆う長さに変える。
  -->
  <!--
    射出口の高さと仰角。装甲板の帯 (base_link の 0.375〜0.525) に弾道が
    できるだけ長く留まるように決めた値。

    装甲板の高さの半分 (0.075 m、中心 0.45 の上下 0.0375) に収まる条件で
    初速 20 m/s の放物線を最適化すると、射出口 0.415 m・仰角 3.4 度で
    帯に 4.87 m 留まる (仰角 0・射出口 0.505 の従来は 3.26 m)。

    仰角を浅く取ってあるのは、射出のばらつきに対する余裕を残すため。
    実測の仰角の幅は 6 度前後あり、±2 度ずれると装甲板全体で 1.43 m しか
    保証できない。帯の端をなぞる深い仰角にすると、ばらつきでさらに短くなる。

    取り付け高さは射出口の目標高さから逆算する。仰角を付けると射出輪の
    位置が回るので、その分を差し引かないと狙った高さにならない。
  -->
  <xacro:property name="shooter_elevation" value="${radians(3.4)}"/>
  <xacro:property name="shooter_muzzle_z" value="0.415"/>
  <xacro:property name="roller_mount_x" value="0.15"/>
  <xacro:property name="roller_mount_z" value="0.055"/>
  <xacro:property name="shooter_mount_z"
                  value="${shooter_muzzle_z
                          - (roller_mount_x * sin(shooter_elevation)
                             + roller_mount_z * cos(shooter_elevation))}"/>

  <xacro:property name="barrel_clearance" value="0.005"/>
  <xacro:property name="barrel_thickness" value="0.04"/>
  <xacro:property name="barrel_back_x"  value="-0.12"/>
  <xacro:property name="barrel_front_x" value="0.20"/>
  <xacro:property name="barrel_length"
                  value="${barrel_front_x - barrel_back_x}"/>
  <xacro:property name="barrel_center_x"
                  value="${(barrel_front_x + barrel_back_x) / 2}"/>
  <!-- 下面 = ディスク上面 (0.06) + 隙間。中心はそこから厚みの半分だけ上。 -->
  <xacro:property name="barrel_center_z"
                  value="${0.06 + barrel_clearance + barrel_thickness / 2}"/>

  <xacro:property name="roller_mass"   value="0.5"/>
  <xacro:property name="roller_izz"
                  value="${0.5 * roller_mass * roller_radius * roller_radius}"/>
  <xacro:property name="roller_ixx"
                  value="${roller_mass * (3 * roller_radius * roller_radius + roller_width * roller_width) / 12.0}"/>

  <xacro:macro name="shooter_v0" params="parent *joint_origin">
        <joint name="shooter_shaft_link_joint" type="fixed">
          <xacro:insert_block name="joint_origin"/>
          <parent link="${parent}"/>
          <child link="shooter_base_link"/>
        </joint>

        <link name="shooter_base_link">
          <visual>
                <origin xyz="0.05 0.0 0.0"/>
                <geometry>
                  <box size="0.3 0.18 0.08" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <origin xyz="0.05 0.0 0.0"/>
                <geometry>
                  <box size="0.3 0.18 0.08" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_barel_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="${barrel_center_x} 0.0 ${barrel_center_z}"/>
          <parent link="shooter_base_link"/>
          <child link="shooter_barel_link"/>
        </joint>

        <link name="shooter_barel_link">
          <visual>
                <geometry>
                  <box size="${barrel_length} 0.18 ${barrel_thickness}" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <box size="${barrel_length} 0.18 ${barrel_thickness}" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_wall1_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="${wall_center_x} ${wall_y} ${wall_center_z}"/>
          <parent link="shooter_base_link"/>
          <child link="shooter_wall1_link"/>
        </joint>

        <link name="shooter_wall1_link">
          <visual>
                <geometry>
                  <box size="${wall_length} ${wall_thickness} ${wall_height}" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <box size="${wall_length} ${wall_thickness} ${wall_height}" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_wall2_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="${wall_center_x} ${-wall_y} ${wall_center_z}"/>
          <parent link="shooter_base_link"/>
          <child link="shooter_wall2_link"/>
        </joint>

        <link name="shooter_wall2_link">
          <visual>
                <geometry>
                  <box size="${wall_length} ${wall_thickness} ${wall_height}" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <box size="${wall_length} ${wall_thickness} ${wall_height}" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_wall3_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="0.25 0.12 0.05"/>
          <parent link="shooter_base_link"/>
          <child link="shooter_wall3_link"/>
        </joint>

        <link name="shooter_wall3_link">
          <visual>
                <geometry>
                  <box size="0.1 0.02 0.08" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <box size="0.1 0.02 0.08" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_wall4_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="0.25 -0.12 0.05"/>
          <parent link="shooter_base_link"/>
          <child link="shooter_wall4_link"/>
        </joint>

        <link name="shooter_wall4_link">
          <visual>
                <geometry>
                  <box size="0.1 0.02 0.08" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <box size="0.1 0.02 0.08" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>
                        
        <joint name="shooter_pole1_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="0.07778 0.07778 0.315"/> <!-- disc pos x 0.18 z -0.0925 -->
          <parent link="shooter_base_link"/>
          <child link="shooter_pole1_link"/>
          <axis xyz="0 0 1"/>
        </joint>

        <link name="shooter_pole1_link">
          <visual>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_pole2_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="-0.07778 0.07778 0.315"/> <!-- disc pos x 0.18 z -0.0925 -->
          <parent link="shooter_base_link"/>
          <child link="shooter_pole2_link"/>
          <axis xyz="0 0 1"/>
        </joint>

        <link name="shooter_pole2_link">
          <visual>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_pole3_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="-0.07778 -0.07778 0.315"/> <!-- disc pos x 0.18 z -0.0925 -->
          <parent link="shooter_base_link"/>
          <child link="shooter_pole3_link"/>
          <axis xyz="0 0 1"/>
        </joint>

        <link name="shooter_pole3_link">
          <visual>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_pole4_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="0.07778 -0.07778 0.315"/> <!-- disc pos x 0.18 z -0.0925 -->
          <parent link="shooter_base_link"/>
          <child link="shooter_pole4_link"/>
          <axis xyz="0 0 1"/>
        </joint>

        <link name="shooter_pole4_link">
          <visual>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_pole5_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="0.11 0.0 0.34"/> <!-- disc pos x 0.18 z -0.0925 -->
          <parent link="shooter_base_link"/>
          <child link="shooter_pole5_link"/>
          <axis xyz="0 0 1"/>
        </joint>

        <link name="shooter_pole5_link">
          <visual>
                <geometry>
                  <cylinder length="0.45" radius="0.01" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <cylinder length="0.45" radius="0.01" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_pole6_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="-0.11 0.0 0.315"/> <!-- disc pos x 0.18 z -0.0925 -->
          <parent link="shooter_base_link"/>
          <child link="shooter_pole6_link"/>
          <axis xyz="0 0 1"/>
        </joint>

        <link name="shooter_pole6_link">
          <visual>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>
        
        <joint name="shooter_pole7_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="0.0 0.11 0.315"/> <!-- disc pos x 0.18 z -0.0925 -->
          <parent link="shooter_base_link"/>
          <child link="shooter_pole7_link"/>
          <axis xyz="0 0 1"/>
        </joint>

        <link name="shooter_pole7_link">
          <visual>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>

        <joint name="shooter_pole8_link_joint" type="fixed">
          <origin rpy="0 0 0" xyz="0.0 -0.11 0.315"/> <!-- disc pos x 0.18 z -0.0925 -->
          <parent link="shooter_base_link"/>
          <child link="shooter_pole8_link"/>
          <axis xyz="0 0 1"/>
        </joint>

        <link name="shooter_pole8_link">
          <visual>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
                <geometry>
                  <cylinder length="0.5" radius="0.01" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>
        
         <joint name="shooter_loader_link_joint" type="prismatic">
          <origin rpy="0 0 0" xyz="-0.12 0 0.05"/>
          <limit lower="0.0" upper="0.2" effort="100" velocity="10.0" />
          <!-- Unity: 装填機構。ros2_control の指令上限は 6 なので velocity もそれ以上に取る -->
          <drive stiffness="0.0" damping="30000.0"/>
          <parent link="shooter_base_link"/>
          <child link="shooter_loader_link"/>
          <axis xyz="1 0 0"/>
        </joint>

        <link name="shooter_loader_link">
          <visual>
            <origin rpy="0 0 0" xyz="-0.05 0 0.0"/>
                <geometry>
                  <box size="0.1 0.1 0.01" />
                </geometry>
                <material name="shooter_unit"/>
          </visual>
          <collision>
            <collision_material name="shooter_unit"/>
            <origin rpy="0 0 0" xyz="-0.05 0 0.0"/>
                <geometry>
                  <box size="0.1 0.1 0.01" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.1" ixy="0" ixz="0"
                                 iyy="0.1" iyz="0"
                                 izz="0.1" />
          </inertial>
        </link>


         <joint name="shooter_wheel1_link_joint" type="continuous">
          <origin rpy="0 0 0" xyz="${roller_mount_x} ${roller_offset} ${roller_mount_z}"/>
          <parent link="shooter_base_link"/>
          <child link="shooter_wheel1_link"/>
          <axis xyz="0 0 1"/>
          <!-- Unity: 射出輪。ros2_control の指令上限 1600 rad/s に合わせる -->
          <drive stiffness="0.0" damping="100.0"/>
          <limit effort="100.0" velocity="2000.0"/>
        </joint>

        <link name="shooter_wheel1_link">
          <visual>
                <geometry>
                  <cylinder length="${roller_width}" radius="${roller_radius}" />
                </geometry>
                <material name="gray"/>
          </visual>
          <collision>
            <!-- 射出輪だけは掴む側。shooter_unit (dynamic 0, combine minimum) の
                 ままだと接線力が出ず、フライホイール式として成立しない。 -->
            <collision_material name="shooter_roller"/>
                <geometry>
                  <cylinder length="${roller_width}" radius="${roller_radius}" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="${roller_mass}"/>
                <inertia ixx="${roller_ixx}" ixy="0" ixz="0"
                                 iyy="${roller_ixx}" iyz="0"
                                 izz="${roller_izz}" />
          </inertial>
        </link>

         <joint name="shooter_wheel2_link_joint" type="continuous">
          <origin rpy="0 0 0" xyz="${roller_mount_x} ${-roller_offset} ${roller_mount_z}"/>
          <parent link="shooter_base_link"/>
          <child link="shooter_wheel2_link"/>
          <axis xyz="0 0 -1"/>
          <!-- Unity: 射出輪。ros2_control の指令上限 1600 rad/s に合わせる -->
          <drive stiffness="0.0" damping="100.0"/>
          <limit effort="100.0" velocity="2000.0"/>
        </joint>

        <link name="shooter_wheel2_link">
          <visual>
                <geometry>
                  <cylinder length="${roller_width}" radius="${roller_radius}" />
                </geometry>
                <material name="gray"/>
          </visual>
          <collision>
            <collision_material name="shooter_roller"/>
                <geometry>
                  <cylinder length="${roller_width}" radius="${roller_radius}" />
                </geometry>
          </collision>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="${roller_mass}"/>
                <inertia ixx="${roller_ixx}" ixy="0" ixz="0"
                                 iyy="${roller_ixx}" iyz="0"
                                 izz="${roller_izz}" />
          </inertial>
        </link>

  </xacro:macro>

</robot>

