<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find sample_robot_description)/urdf/base/base.gazebo.xacro"/>

  <!--
    接地脚 1 個ぶん。車体を床から浮かせる球の当たり判定と、車輪の見た目を
    base_frame_link へ直に足す。リンクもジョイントも増やさないので、
    ソルバのコストは変わらない。

    位置はオムニホイールの取り付け位置 (base_link 基準で ±0.35, ±0.35, 0.05)
    に合わせる。base_frame_link は base_link の +0.06 なので z は -0.01。
    半径 0.05 は車輪半径と同じで、これで車体下面の地上高 5 cm が元どおりになる。

    車輪を外すと車体が 5 cm 下がって床に直付きになり、フィールドの構造物に
    引っ掛かって走れなくなる (実測: 脚なしでは 156 N を掛けても速度 0、
    脚ありで指令の 100%)。見た目もハウジングの STL をそのまま置いて、
    車輪があるように見せる (回転はしない)。
  -->
  <xacro:macro name="base_skid" params="x y yaw">
        <visual>
          <origin xyz="${x} ${y} -0.01" rpy="0 ${pi/2} ${yaw}"/>
          <geometry>
            <mesh filename="file://$(find sample_robot_description)/meshes/STL/omni_housing_100mm.stl" />
          </geometry>
          <material name="gray"/>
        </visual>
        <collision>
          <collision_material name="skid"/>
          <origin xyz="${x} ${y} -0.01"/>
          <geometry>
            <sphere radius="0.05"/>
          </geometry>
        </collision>
  </xacro:macro>

  <!--
    skids:=true で接地脚を付ける。BodyTwistDrive で走らせる構成用。
    オムニホイールを付ける構成では false のままにすること (二重に接地する)。
  -->
  <xacro:macro name="base_v0" params="parent *joint_origin skids:=false">
        <joint name="base_frame_link_joint" type="fixed">
          <xacro:insert_block name="joint_origin"/>
          <parent link="${parent}"/>
          <child link="base_frame_link"/>
        </joint>

        <link name="base_frame_link">
          <visual>
                <geometry>
                  <box size="0.6 0.6 0.02" />
                </geometry>
                <material name="white"/>
          </visual>
          <collision>
            <collision_material name="robot_body"/>
                <geometry>
                  <box size="0.6 0.6 0.02" />
                </geometry>
          </collision>
          <xacro:if value="${skids}">
            <xacro:base_skid x="0.35"  y="0.35"  yaw="${pi/4}"/>
            <xacro:base_skid x="-0.35" y="0.35"  yaw="${pi*3/4}"/>
            <xacro:base_skid x="-0.35" y="-0.35" yaw="${-pi*3/4}"/>
            <xacro:base_skid x="0.35"  y="-0.35" yaw="${-pi/4}"/>
          </xacro:if>
          <inertial>
                <origin xyz="0 0 0"/>
                <mass value="20.0"/>
                <inertia ixx="5" ixy="0" ixz="0"
                                 iyy="5" iyz="0"
                                 izz="5" />
          </inertial>
        </link>

        <joint name="bumper1_joint" type="fixed">
          <parent link="${parent}"/>
          <child  link="bumper1_link"/>
          <origin xyz="-0.45 0.0 0.10" rpy="0 0 0"/>
        </joint>

        <link name="bumper1_link">
          <visual>
            <geometry>
              <box size="0.01 0.9 0.10" />
            </geometry>
            <material name="white"/>
          </visual>
          <collision>
            <collision_material name="robot_body"/>
            <geometry>
              <box size="0.01 0.9 0.10" />
            </geometry>
          </collision>
          <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.4"/>
            <inertia ixx="0.1" ixy="0" ixz="0"
                               iyy="0.1" iyz="0"
                                         izz="0.1" />
          </inertial>
        </link>

        <joint name="bumper2_joint" type="fixed">
          <parent link="${parent}"/>
          <child  link="bumper2_link"/>
          <origin xyz="0.0 0.45 0.10" rpy="0 0 0"/>
        </joint>

        <link name="bumper2_link">
          <visual>
            <geometry>
              <box size="0.9 0.01 0.10" />
            </geometry>
            <material name="white"/>
          </visual>
          <collision>
            <collision_material name="robot_body"/>
            <geometry>
              <box size="0.9 0.01 0.10" />
            </geometry>
          </collision>
          <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.4"/>
            <inertia ixx="0.1" ixy="0" ixz="0"
                               iyy="0.1" iyz="0"
                                         izz="0.1" />
          </inertial>
        </link>

        <joint name="bumper3_joint" type="fixed">
          <parent link="${parent}"/>
          <child  link="bumper3_link"/>
          <origin xyz="0.0 -0.45 0.10" rpy="0 0 0"/>
        </joint>

        <link name="bumper3_link">
          <visual>
            <geometry>
              <box size="0.9 0.01 0.10" />
            </geometry>
            <material name="white"/>
          </visual>
          <collision>
            <collision_material name="robot_body"/>
            <geometry>
              <box size="0.9 0.01 0.10" />
            </geometry>
          </collision>
          <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.4"/>
            <inertia ixx="0.1" ixy="0" ixz="0"
                               iyy="0.1" iyz="0"
                                         izz="0.1" />
          </inertial>
        </link>

        <joint name="bumper4_joint" type="fixed">
          <parent link="${parent}"/>
          <child  link="bumper4_link"/>
          <origin xyz="0.45 0.0 0.10" rpy="0 0 0"/>
        </joint>

        <link name="bumper4_link">
          <visual>
            <geometry>
              <box size="0.01 0.9 0.10" />
            </geometry>
            <material name="white"/>
          </visual>
          <collision>
            <collision_material name="robot_body"/>
            <geometry>
              <box size="0.01 0.9 0.10" />
            </geometry>
          </collision>
          <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.4"/>
            <inertia ixx="0.1" ixy="0" ixz="0"
                               iyy="0.1" iyz="0"
                                         izz="0.1" />
          </inertial>
        </link>
  
  </xacro:macro>

</robot>

